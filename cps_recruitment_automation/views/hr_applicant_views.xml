    <!-- Download button on Job Position form -->






    <record id="hr_job_view_form_cps_report" model="ir.ui.view">
        <field name="name">hr.job.form.cps.report</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[1]" position="before">
                <button string="Download Screening Report"
                        type="object"
                        name="action_cps_download_screening_report"
                        class="btn-secondary"/>
            </xpath>
        </field>
    </record>

