<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Schedule form -->
    <record id="view_interview_schedule_form" model="ir.ui.view">
        <field name="name">cps.interview.schedule.form</field>
        <field name="model">cps.interview.schedule</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_slots" type="object"
                            string="Generate Slots" class="btn-primary" icon="fa-th"/>
                    <button name="action_autofill_by_score" type="object"
                            string="Auto-fill by Score" class="btn-secondary" icon="fa-magic"/>
                    <button name="action_send_invitations" type="object"
                            string="Send Invitations" class="btn-primary" icon="fa-envelope"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Days &amp; Times">
                            <field name="session_id"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="day_start_time" widget="float_time"/>
                            <field name="day_end_time" widget="float_time"/>
                        </group>
                        <group string="Slots &amp; Breaks">
                            <field name="slot_duration"/>
                            <field name="gap_between_slots"/>
                            <field name="break_start" widget="float_time"/>
                            <field name="break_end" widget="float_time"/>
                            <field name="max_per_day"/>
                            <field name="location"/>
                        </group>
                    </group>
                    <group>
                        <field name="auto_send_date"/>
                        <field name="send_reminders"/>
                        <field name="invitations_sent" readonly="1"/>
                        <field name="slot_count" readonly="1"/>
                        <field name="assigned_count" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Slots">
                            <field name="slot_ids">
                                <list editable="bottom" default_order="date, start_time" create="0">
                                    <field name="date"/>
                                    <field name="time_label" string="Time"/>
                                    <field name="session_applicant_ids" column_invisible="1"/>
                                    <field name="applicant_id"
                                           options="{'no_create': True}"/>
                                    <field name="candidate_score" string="Score"/>
                                    <field name="calendar_event_id" column_invisible="1"/>
                                    <field name="invited_from_other_role" string="Other Role" optional="show"/>
                                    <field name="state"/>
                                    <button name="action_send_invite" type="object"
                                            string="Invite" icon="fa-envelope"
                                            invisible="not applicant_id"/>
                                    <button name="action_send_reminder" type="object"
                                            string="Remind" icon="fa-bell"
                                            invisible="state not in ('invited','confirmed')"/>
                                    <button name="action_send_reschedule" type="object"
                                            string="Reschedule" icon="fa-clock-o"
                                            invisible="state not in ('invited','confirmed')"/>
                                    <button name="action_create_calendar_event" type="object"
                                            string="Outlook" icon="fa-calendar-plus-o"
                                            invisible="not applicant_id or calendar_event_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Schedule list -->
    <record id="view_interview_schedule_list" model="ir.ui.view">
        <field name="name">cps.interview.schedule.list</field>
        <field name="model">cps.interview.schedule</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="slot_count"/>
                <field name="assigned_count"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_interview_schedule" model="ir.actions.act_window">
        <field name="name">Interview Schedules</field>
        <field name="res_model">cps.interview.schedule</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- Top-level app with custom icon -->
    <menuitem id="menu_interview_schedule_root"
              name="Interview Schedules"
              web_icon="cps_interview_schedule,static/description/icon.png"
              sequence="55"/>
    <menuitem id="menu_interview_schedule"
              name="Schedules"
              parent="menu_interview_schedule_root"
              action="action_interview_schedule"
              sequence="10"/>


    <!-- Slot Kanban -->
    <record id="view_interview_slot_kanban" model="ir.ui.view">
        <field name="name">cps.interview.slot.kanban</field>
        <field name="model">cps.interview.slot</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="candidate_name"/>
                <field name="time_label"/>
                <field name="candidate_score"/>
                <field name="date"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div style="padding:10px;">
                            <div style="font-weight:bold;font-size:14px;">
                                <field name="candidate_name"/>
                            </div>
                            <div style="color:#666;font-size:12px;margin-top:4px;">
                                <i class="fa fa-calendar"/> <field name="date"/>
                            </div>
                            <div style="color:#666;font-size:12px;">
                                <i class="fa fa-clock-o"/> <field name="time_label"/>
                            </div>
                            <div style="margin-top:6px;">
                                <span class="badge text-bg-success" t-if="record.candidate_score.raw_value">
                                    Score: <field name="candidate_score"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_interview_slot_kanban" model="ir.actions.act_window">
        <field name="name">Interview Slots</field>
        <field name="res_model">cps.interview.slot</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <menuitem id="menu_interview_slots"
              name="Slots Board"
              parent="menu_interview_schedule_root"
              action="action_interview_slot_kanban"
              sequence="20"/>

</odoo>
