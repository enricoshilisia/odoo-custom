<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_auto_send_invitations" model="ir.cron">
        <field name="name">Interview: Auto-send Invitations</field>
        <field name="model_id" ref="model_cps_interview_schedule"/>
        <field name="state">code</field>
        <field name="code">model._cron_auto_send_invitations()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_send_day_reminders" model="ir.cron">
        <field name="name">Interview: 24h Day-before Reminders</field>
        <field name="model_id" ref="model_cps_interview_schedule"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_day_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
