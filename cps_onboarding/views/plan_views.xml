<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Reusable task list view — Pre-Boarding -->
    <record id="view_onboarding_task_list_preboarding" model="ir.ui.view">
        <field name="name">cps.onboarding.task.list.preboarding</field>
        <field name="model">cps.onboarding.task</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'done'"
                  decoration-danger="state == 'overdue'"
                  decoration-muted="state == 'skipped'"
                  default_order="due_date">
                <field name="name" string="Task"/>
                <field name="assignee_role" string="Role"/>
                <field name="assigned_user_id" string="Assigned To"/>
                <field name="due_date"/>
                <field name="odoo_module" string="Module" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-warning="state == 'in_progress'"
                       decoration-danger="state == 'overdue'"
                       decoration-muted="state == 'skipped'"/>
                <field name="completed_date" optional="hide"/>
                <field name="completion_note" string="Note" optional="hide"/>
                <button name="action_mark_done" string="Mark Done"
                        type="object" icon="fa-check"
                        invisible="state == 'done' or state == 'skipped'"/>
                <button name="action_mark_in_progress" string="In Progress"
                        type="object" icon="fa-play"
                        invisible="state != 'pending'"/>
                <button name="action_mark_pending" string="Undo"
                        type="object" icon="fa-undo"
                        invisible="state != 'done'"/>
                <button name="action_skip" string="Skip"
                        type="object" icon="fa-forward"
                        invisible="state in ('done','skipped')"/>
            </list>
        </field>
    </record>

    <!-- Plan Form -->
    <record id="view_onboarding_plan_form" model="ir.ui.view">
        <field name="name">cps.onboarding.plan.form</field>
        <field name="model">cps.onboarding.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_tasks" string="Generate Tasks from Template"
                            type="object" class="btn-primary"
                            invisible="state != 'draft' or not template_id"/>
                    <button name="action_activate" string="Activate Plan"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_send_portal_link" string="Send Portal Link to Employee"
                            type="object" class="btn-secondary"
                            invisible="state not in ('active','draft')"/>
                    <button name="action_send_overdue_reminders" string="Send Overdue Reminders"
                            type="object"
                            invisible="state != 'active'"/>
                    <button name="action_complete" string="Mark Complete"
                            type="object"
                            invisible="state != 'active'"/>
                    <button name="action_cancel" string="Cancel"
                            type="object"
                            invisible="state in ('completed','cancelled')"/>
                    <button name="action_reset_draft" string="Reset to Draft"
                            type="object"
                            invisible="state != 'cancelled'"/>
                    <button name="action_view_report" string="Download PDF Report"
                            type="object" class="btn-secondary"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-check-circle">
                            <div class="o_stat_info">
                                <field name="progress_pct" class="o_stat_value"/>
                                <span class="o_stat_text">% Done</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" icon="fa-tasks">
                            <div class="o_stat_info">
                                <field name="done_tasks" class="o_stat_value"/>
                                <span class="o_stat_text">Tasks Done</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" icon="fa-exclamation-triangle"
                                invisible="overdue_tasks == 0">
                            <div class="o_stat_info">
                                <field name="overdue_tasks" class="o_stat_value"
                                       style="color:#e74c3c;"/>
                                <span class="o_stat_text">Overdue</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Jane Doe Onboarding Plan"/></h1>
                    </div>
                    <group>
                        <group string="Employee">
                            <field name="employee_id"/>
                            <field name="job_id" readonly="1"/>
                            <field name="department_id" readonly="1"/>
                            <field name="start_date"/>
                        </group>
                        <group string="Plan Setup">
                            <field name="template_id"/>
                            <field name="current_phase" readonly="1"/>
                            <field name="health" widget="badge"
                                   decoration-success="health == 'green' or health == 'complete'"
                                   decoration-warning="health == 'amber'"
                                   decoration-danger="health == 'red'"/>
                            <field name="portal_url" widget="url" string="Employee Portal Link"/>
                        </group>
                    </group>
                    <group string="Assigned People">
                        <group>
                            <field name="hr_owner_id"/>
                            <field name="line_manager_id"/>
                        </group>
                        <group>
                            <field name="it_owner_id"/>
                            <field name="buddy_id"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Pre-Boarding">
                            <field name="tasks_html_preboarding"
                                   widget="html" readonly="1"/>
                        </page>
                        <page string="Phase 1 — Foundation (Days 1–30)">
                            <field name="tasks_html_phase1"
                                   widget="html" readonly="1"/>
                        </page>
                        <page string="Phase 2 — Assessment (Days 31–60)">
                            <field name="tasks_html_phase2"
                                   widget="html" readonly="1"/>
                        </page>
                        <page string="Phase 3 — Execution (Days 61–90)">
                            <field name="tasks_html_phase3"
                                   widget="html" readonly="1"/>
                        </page>
                        <page string="All Tasks">
                            <field name="task_ids">
                                <list decoration-success="state == 'done'"
                                      decoration-danger="state == 'overdue'"
                                      decoration-muted="state == 'skipped'"
                                      default_order="phase,due_date">
                                    <field name="phase"/>
                                    <field name="name" string="Task"/>
                                    <field name="assignee_role" string="Role"/>
                                    <field name="assigned_user_id" string="Assigned To"/>
                                    <field name="due_date"/>
                                    <field name="odoo_module" string="Module" optional="hide"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'done'"
                                           decoration-warning="state == 'in_progress'"
                                           decoration-danger="state == 'overdue'"
                                           decoration-muted="state == 'skipped'"/>
                                    <field name="completed_date" optional="hide"/>
                                    <field name="completion_note" string="Note" optional="hide"/>
                                    <button name="action_mark_done" string="Mark Done"
                                            type="object" icon="fa-check"
                                            invisible="state == 'done' or state == 'skipped'"/>
                                    <button name="action_mark_in_progress" string="In Progress"
                                            type="object" icon="fa-play"
                                            invisible="state != 'pending'"/>
                                    <button name="action_mark_pending" string="Undo"
                                            type="object" icon="fa-undo"
                                            invisible="state != 'done'"/>
                                    <button name="action_skip" string="Skip"
                                            type="object" icon="fa-forward"
                                            invisible="state in ('done','skipped')"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Plan List -->
    <record id="view_onboarding_plan_list" model="ir.ui.view">
        <field name="name">cps.onboarding.plan.list</field>
        <field name="model">cps.onboarding.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="job_id"/>
                <field name="department_id"/>
                <field name="start_date"/>
                <field name="current_phase"/>
                <field name="progress_pct" widget="progressbar"/>
                <field name="done_tasks" string="Done"/>
                <field name="total_tasks" string="Total"/>
                <field name="overdue_tasks" string="Overdue"
                       decoration-danger="overdue_tasks &gt; 0"/>
                <field name="health" widget="badge"
                       decoration-success="health in ('green','complete')"
                       decoration-warning="health == 'amber'"
                       decoration-danger="health == 'red'"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'completed'"
                       decoration-warning="state == 'active'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Plan Search -->
    <record id="view_onboarding_plan_search" model="ir.ui.view">
        <field name="name">cps.onboarding.plan.search</field>
        <field name="model">cps.onboarding.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="job_id"/>
                <field name="department_id"/>
                <filter string="Active" name="active" domain="[('state','=','active')]"/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Completed" name="completed" domain="[('state','=','completed')]"/>
                <filter string="Has Overdue Tasks" name="overdue"
                        domain="[('overdue_tasks','&gt;',0)]"/>
                <group expand="0" string="Group By">
                    <filter string="Department" name="grp_dept"
                            context="{'group_by':'department_id'}"/>
                    <filter string="Job Position" name="grp_job"
                            context="{'group_by':'job_id'}"/>
                    <filter string="Status" name="grp_state"
                            context="{'group_by':'state'}"/>
                    <filter string="Health" name="grp_health"
                            context="{'group_by':'health'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Task List View grouped by phase -->
    <record id="view_onboarding_task_list" model="ir.ui.view">
        <field name="name">cps.onboarding.task.list</field>
        <field name="model">cps.onboarding.task</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'done'"
                  decoration-danger="state == 'overdue'"
                  decoration-muted="state == 'skipped'"
                  default_order="phase,due_date"
                  expand="1">
                <field name="phase" column_invisible="1"/>
                <field name="name" string="Task"/>
                <field name="plan_id" string="Plan"/>
                <field name="assignee_role" string="Role"/>
                <field name="assigned_user_id" string="Assigned To"/>
                <field name="due_date"/>
                <field name="odoo_module" string="Module" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-warning="state == 'in_progress'"
                       decoration-danger="state == 'overdue'"
                       decoration-muted="state == 'skipped'"/>
                <field name="completed_date" optional="hide"/>
                <button name="action_mark_done" string="Mark Done"
                        type="object" icon="fa-check"
                        invisible="state == 'done' or state == 'skipped'"/>
                <button name="action_mark_in_progress" string="In Progress"
                        type="object" icon="fa-play"
                        invisible="state != 'pending'"/>
                <button name="action_mark_pending" string="Undo"
                        type="object" icon="fa-undo"
                        invisible="state != 'done'"/>
                <button name="action_skip" string="Skip"
                        type="object" icon="fa-forward"
                        invisible="state in ('done','skipped')"/>
            </list>
        </field>
    </record>

    <!-- Task Form View -->
    <record id="view_onboarding_task_form" model="ir.ui.view">
        <field name="name">cps.onboarding.task.form</field>
        <field name="model">cps.onboarding.task</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_done" string="Mark Done"
                            type="object" class="btn-primary"
                            invisible="state == 'done' or state == 'skipped'"/>
                    <button name="action_mark_in_progress" string="In Progress"
                            type="object"
                            invisible="state != 'pending'"/>
                    <button name="action_mark_pending" string="Reset to Pending"
                            type="object"
                            invisible="state != 'done'"/>
                    <button name="action_skip" string="Skip"
                            type="object"
                            invisible="state in ('done','skipped')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="plan_id"/>
                            <field name="phase"/>
                            <field name="assignee_role"/>
                            <field name="assigned_user_id"/>
                        </group>
                        <group>
                            <field name="due_date"/>
                            <field name="completed_date"/>
                            <field name="odoo_module"/>
                            <field name="is_employee_visible"/>
                            <field name="requires_document"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="description" nolabel="1"/>
                        <field name="completion_note" nolabel="1"
                               placeholder="Completion note..."/>
                    </group>
                    <group string="Document" invisible="not requires_document">
                        <field name="attached_document" filename="attached_document_filename"/>
                        <field name="attached_document_filename" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Task Search View -->
    <record id="view_onboarding_task_search" model="ir.ui.view">
        <field name="name">cps.onboarding.task.search</field>
        <field name="model">cps.onboarding.task</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="plan_id"/>
                <field name="assigned_user_id"/>
                <filter string="My Tasks" name="my_tasks"
                        domain="[('assigned_user_id','=',uid)]"/>
                <filter string="Pending" name="pending"
                        domain="[('state','=','pending')]"/>
                <filter string="In Progress" name="in_progress"
                        domain="[('state','=','in_progress')]"/>
                <filter string="Done" name="done"
                        domain="[('state','=','done')]"/>
                <filter string="Overdue" name="overdue"
                        domain="[('state','=','overdue')]"/>
                <filter string="Active Plans Only" name="active_plans"
                        domain="[('plan_id.state','=','active')]"/>
                <group expand="1" string="Group By">
                    <filter string="Phase" name="grp_phase"
                            context="{'group_by':'phase'}"/>
                    <filter string="Plan" name="grp_plan"
                            context="{'group_by':'plan_id'}"/>
                    <filter string="Assigned To" name="grp_user"
                            context="{'group_by':'assigned_user_id'}"/>
                    <filter string="Status" name="grp_state"
                            context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Tasks by Phase Action -->
    <record id="action_onboarding_task_by_phase" model="ir.actions.act_window">
        <field name="name">Onboarding Tasks</field>
        <field name="res_model">cps.onboarding.task</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_onboarding_task_list"/>
        <field name="search_view_id" ref="view_onboarding_task_search"/>
        <field name="context">{
            'search_default_grp_phase': 1,
            'search_default_active_plans': 1
        }</field>
    </record>

    <!-- Plan Action -->
    <record id="action_onboarding_plan" model="ir.actions.act_window">
        <field name="name">Onboarding Plans</field>
        <field name="res_model">cps.onboarding.plan</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_onboarding_plan_search"/>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <!-- Active Plans Only -->
    <record id="action_onboarding_plan_active" model="ir.actions.act_window">
        <field name="name">Active Onboarding Plans</field>
        <field name="res_model">cps.onboarding.plan</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state','=','active')]</field>
        <field name="search_view_id" ref="view_onboarding_plan_search"/>
    </record>

</odoo>
