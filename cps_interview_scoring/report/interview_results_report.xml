<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_interview_results_report" model="ir.actions.report">
        <field name="name">Interview Results</field>
        <field name="model">cps.interview.session</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">cps_interview_scoring.report_interview_results</field>
        <field name="report_file">cps_interview_scoring.report_interview_results</field>
        <field name="binding_model_id" ref="model_cps_interview_session"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_interview_results">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="session">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Interview Results: <t t-esc="session.name"/></h2>
                        <p>
                            <strong>Job Position:</strong> <t t-esc="session.job_id.name"/><br/>
                            <t t-if="session.interview_date">
                                <strong>Interview Date:</strong> <t t-esc="session.interview_date"/>
                            </t>
                        </p>

                        <t t-set="results" t-value="session.get_results()"/>

                        <table style="width:100%;border-collapse:collapse;margin-top:15px;">
                            <thead>
                                <tr style="background:#2c3e50;color:#fff;">
                                    <th style="padding:8px;text-align:left;">#</th>
                                    <th style="padding:8px;text-align:left;">Candidate</th>
                                    <t t-foreach="session.question_ids" t-as="q">
                                        <th style="padding:8px;text-align:center;font-size:11px;">
                                            Q<t t-esc="q_index + 1"/>
                                        </th>
                                    </t>
                                    <th style="padding:8px;text-align:center;">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="results" t-as="row">
                                    <tr t-att-style="'background:#fffde7;' if row_index == 0 else ''">
                                        <td style="padding:8px;"><t t-esc="row_index + 1"/></td>
                                        <td style="padding:8px;">
                                            <strong t-if="row_index == 0">
                                                ★ <t t-esc="row['applicant'].partner_name"/>
                                            </strong>
                                            <span t-else="">
                                                <t t-esc="row['applicant'].partner_name"/>
                                            </span>
                                        </td>
                                        <t t-foreach="row['question_scores']" t-as="qs">
                                            <td style="padding:8px;text-align:center;">
                                                <t t-esc="qs"/>
                                            </td>
                                        </t>
                                        <td style="padding:8px;text-align:center;font-weight:bold;">
                                            <t t-esc="row['total']"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <t t-if="results">
                            <div style="margin-top:20px;padding:12px;background:#eafaf1;border-left:4px solid #27ae60;border-radius:4px;">
                                <strong>Top Candidate:</strong>
                                <t t-esc="results[0]['applicant'].partner_name"/>
                                — Total Score: <t t-esc="results[0]['total']"/>
                            </div>
                        </t>

                        <div style="margin-top:30px;">
                            <h4>Panelist Submission Status</h4>
                            <table style="width:50%;border-collapse:collapse;">
                                <tr style="background:#ecf0f1;">
                                    <th style="padding:6px;text-align:left;">Panelist</th>
                                    <th style="padding:6px;text-align:left;">Status</th>
                                </tr>
                                <t t-foreach="session.token_ids" t-as="tok">
                                    <tr>
                                        <td style="padding:6px;"><t t-esc="tok.user_id.name"/></td>
                                        <td style="padding:6px;">
                                            <t t-esc="'Submitted' if tok.state == 'submitted' else 'Pending'"/>
                                        </td>
                                    </tr>
                                </t>
                            </table>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
